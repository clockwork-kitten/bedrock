{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "types": ["node"],
    "paths": {
      "ast-types/lib/gen/kinds.js": ["./node_modules/@types/jscodeshift/node_modules/ast-types/lib/gen/kinds.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/__fixtures__"]
}
